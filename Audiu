package com.example.fm1bridge

import java.io.File
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.math.abs

// ---------------------------------------------------------------
// WAV and PCM helpers (16-bit PCM only)
// ---------------------------------------------------------------

class WavInfo(val sampleRate: Int, val channels: Int, val dataOffset: Int, val dataLen: Int)

private fun le16(b: ByteArray, p: Int): Int =
    (b[p].toInt() and 0xFF) or ((b[p + 1].toInt() and 0xFF) shl 8)

private fun le32(b: ByteArray, p: Int): Int = le16(b, p) or (le16(b, p + 2) shl 16)

fun parseWav(b: ByteArray, total: Long): WavInfo? {
    if (b.size < 44) return null
    if (String(b, 0, 4, Charsets.US_ASCII) != "RIFF") return null
    if (String(b, 8, 4, Charsets.US_ASCII) != "WAVE") return null
    var pos = 12
    var fmt = 0
    var ch = 0
    var rate = 0
    var bits = 0
    while (pos + 8 <= b.size) {
        val id = String(b, pos, 4, Charsets.US_ASCII)
        val size = le32(b, pos + 4).toLong() and 0xFFFFFFFFL
        if (id == "fmt " && pos + 24 <= b.size) {
            fmt = le16(b, pos + 8)
            ch = le16(b, pos + 10)
            rate = le32(b, pos + 12)
            bits = le16(b, pos + 22)
        } else if (id == "data") {
            if ((fmt != 1 && fmt != 0xFFFE) || bits != 16 || ch < 1 || ch > 2 || rate <= 0) return null
            val avail = (total - (pos + 8)).coerceAtLeast(0L)
            var len = minOf(size, avail).toInt()
            len -= len % (ch * 2)
            return WavInfo(rate, ch, pos + 8, len)
        }
        val next = pos.toLong() + 8L + size + (size and 1L)
        if (next > Int.MAX_VALUE) return null
        pos = next.toInt()
    }
    return null
}

fun wavHeader(dataSize: Int, rate: Int, ch: Int): ByteArray {
    val h = ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN)
    h.put("RIFF".toByteArray(Charsets.US_ASCII))
    h.putInt(36 + dataSize)
    h.put("WAVE".toByteArray(Charsets.US_ASCII))
    h.put("fmt ".toByteArray(Charsets.US_ASCII))
    h.putInt(16)
    h.putShort(1.toShort())
    h.putShort(ch.toShort())
    h.putInt(rate)
    h.putInt(rate * ch * 2)
    h.putShort((ch * 2).toShort())
    h.putShort(16.toShort())
    h.put("data".toByteArray(Charsets.US_ASCII))
    h.putInt(dataSize)
    return h.array()
}

fun writeWav(file: File, pcm: ByteArray, rate: Int, ch: Int) {
    file.outputStream().use {
        it.write(wavHeader(pcm.size, rate, ch))
        it.write(pcm)
    }
}

fun peakOf(d: ByteArray, len: Int): Int {
    var p = 0
    var i = 0
    while (i + 1 < len) {
        val s = ((d[i + 1].toInt() shl 8) or (d[i].toInt() and 0xFF)).toShort().toInt()
        val a = abs(s)
        if (a > p) p = a
        i += 2
    }
    return p
}

fun scalePcm(d: ByteArray, len: Int, gain: Float) {
    var i = 0
    while (i + 1 < len) {
        val s = ((d[i + 1].toInt() shl 8) or (d[i].toInt() and 0xFF)).toShort().toInt()
        val v = (s * gain).toInt().coerceIn(-32768, 32767)
        d[i] = (v and 0xFF).toByte()
        d[i + 1] = ((v shr 8) and 0xFF).toByte()
        i += 2
    }
}

fun bytesToShorts(b: ByteArray, offset: Int, len: Int): ShortArray {
    val n = len / 2
    val out = ShortArray(n)
    var i = offset
    for (k in 0 until n) {
        out[k] = ((b[i + 1].toInt() shl 8) or (b[i].toInt() and 0xFF)).toShort()
        i += 2
    }
    return out
}

fun shortsToBytes(s: ShortArray): ByteArray {
    val out = ByteArray(s.size * 2)
    for (k in s.indices) {
        val v = s[k].toInt()
        out[2 * k] = (v and 0xFF).toByte()
        out[2 * k + 1] = ((v shr 8) and 0xFF).toByte()
    }
    return out
}

// ---------------------------------------------------------------
// In-memory sample used by the editor and the players
// ---------------------------------------------------------------

class Sample(val data: ShortArray, val rate: Int, val channels: Int) {
    val frames: Int
        get() = data.size / channels
}

fun loadSample(f: File): Sample? {
    return try {
        val bytes = f.readBytes()
        val info = parseWav(bytes, bytes.size.toLong())
        if (info == null || info.dataLen <= 0) {
            null
        } else {
            Sample(bytesToShorts(bytes, info.dataOffset, info.dataLen), info.sampleRate, info.channels)
        }
    } catch (e: Exception) {
        null
    }
}

// ---------------------------------------------------------------
// Conversion for the FM-1 (mono, lower sample rate, small size)
// ---------------------------------------------------------------

class Fm1Preset(val label: String, val rate: Int)

val FM1_PRESETS = listOf(
    Fm1Preset("Tiny - 11.025 kHz mono", 11025),
    Fm1Preset("Small - 16 kHz mono", 16000),
    Fm1Preset("Medium - 22.05 kHz mono", 22050),
    Fm1Preset("Large - 32 kHz mono", 32000),
    Fm1Preset("Full - 44.1 kHz mono", 44100)
)

// Sample memory of one example FM-1 firmware (PIGEON): 496 KiB
const val FM1_BUDGET_BYTES = 496 * 1024

fun fm1SizeBytes(frames: Int, inRate: Int, outRate: Int): Long =
    44L + (frames.toLong() * outRate / inRate) * 2L

fun mixToMono(data: ShortArray, ch: Int): ShortArray {
    if (ch == 1) return data
    val n = data.size / ch
    val out = ShortArray(n)
    for (i in 0 until n) {
        var sum = 0
        for (c in 0 until ch) sum += data[i * ch + c].toInt()
        out[i] = (sum / ch).toShort()
    }
    return out
}

fun resampleMono(src: ShortArray, inRate: Int, outRate: Int): ShortArray {
    if (inRate == outRate || src.isEmpty()) return src
    val outN = ((src.size.toLong() * outRate) / inRate).toInt().coerceAtLeast(1)
    val out = ShortArray(outN)
    val ratio = inRate.toDouble() / outRate
    if (ratio > 1.0) {
        // Downsample: average the input window that belongs to each output sample
        for (i in 0 until outN) {
            val a = (i * ratio).toInt().coerceAtMost(src.size - 1)
            val b = (((i + 1) * ratio).toInt()).coerceAtLeast(a + 1).coerceAtMost(src.size)
            var sum = 0L
            for (j in a until b) sum += src[j].toLong()
            out[i] = (sum / (b - a)).toShort()
        }
    } else {
        // Upsample: linear interpolation
        for (i in 0 until outN) {
            val pos = i * ratio
            val i0 = pos.toInt().coerceAtMost(src.size - 1)
            val i1 = (i0 + 1).coerceAtMost(src.size - 1)
            val frac = pos - i0
            out[i] = (src[i0] * (1.0 - frac) + src[i1] * frac).toInt().toShort()
        }
    }
    return out
}

fun convertForFm1(s: Sample, outRate: Int): ByteArray {
    val mono = mixToMono(s.data, s.channels)
    val rs = resampleMono(mono, s.rate, outRate)
    val pcm = shortsToBytes(rs)
    return wavHeader(pcm.size, outRate, 1) + pcm
}
